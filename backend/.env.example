# Copy to .env (or set these in your host's dashboard). Never commit real values.

# Local development uses SQLite. In production, paste the Neon connection string.
DATABASE_URL=sqlite:///./homestead.db

# Login for the single user
APP_USERNAME=your-name
APP_PASSWORD=change-me

# Long random string used to sign login sessions, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to false only for plain http://localhost testing if cookies fail to save
COOKIE_SECURE=true
